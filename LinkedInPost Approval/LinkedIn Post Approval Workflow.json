      "parameters": {
        "promptType": "define",
        "text": "=You are a senior LinkedIn content editor for software developers and technology professionals.\n\nReview and improve the draft below.\n\nOriginal topic:\n{{ $('On form submission').item.json.Topic }}\n\nWriter's draft:\n{{ $json.output }}\n\nReview standards:\n1. Relevance: The post must address the original topic.\n2. Accuracy: Do not introduce unsupported statistics, claims, or fabricated experiences.\n3. Value: Provide useful, practical insights for the target audience.\n4. Clarity: Use concise sentences, short paragraphs, and easy-to-understand language.\n5. Engagement: Start with a strong hook and end with a meaningful question.\n6. Professionalism: Use a helpful, authentic professional tone without exaggerated marketing claims.\n7. Formatting: Include 3–5 relevant hashtags.\n8. Preserve the original intent while correcting weaknesses and removing repetition.\nTask:\nEvaluate the draft against every standard. Rewrite it wherever necessary to produce the best final LinkedIn post.\n\nReturn ONLY the complete improved LinkedIn post. Do not return review notes, scores, explanations, headings such as \"Final Post\", or quotation marks. {{ $json.output }}",
        "options": {}
      },
